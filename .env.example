# CineHome — copy to .env and fill in real values.
# NEVER commit .env with secrets.

# NextAuth (required in production)
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-long-random-string
AUTH_SECRET=replace-with-long-random-string
NEXTAUTH_URL=http://localhost:3000

# Prisma / SQLite (path relative to app workdir; docker uses /app/db via volume)
DATABASE_URL=file:./db/cinehome.db

# TMDB (server-side; also overridable in Settings UI)
TMDB_API_KEY=your-tmdb-api-key

# Stream scraper URL used by the Next.js app (in-container default below)
# Outside Docker: http://localhost:3030/scrape
SCRAPER_URL=http://127.0.0.1:3030/scrape

# --- Stream scraper process (mini-services/stream-scraper) ---
# Kill switches: set to 0 / false / off to skip that provider (requires container restart).
# PROVIDER_LORDFLIX=0
# Native Videasy/Vidking API (Cypher 1080 MP4 ladder + Yoru HLS). Default ON.
# PROVIDER_VIDEASY=0
# Vidrock English HLS + Astra MP4 ladder (strong anime TMDB coverage). Default ON.
# PROVIDER_VIDROCK=0
# PROVIDER_PLAYWRIGHT=0
# Optional extras (default enabled):
# PROVIDER_VIXSRC=0
# PROVIDER_VIDLINK=0
# PROVIDER_NOTORRENT=0
# PROVIDER_CINEPRO=0
# CinemaOS pure-HTTP (/api/cinemaosv2 progressive MP4). Default ON when unset.
# Gate token + hash secret are baked in providers/cinemaos.ts (public client bundle; may rotate).
# PROVIDER_CINEMAOS=0
#
# CinePro: enabled automatically when CINEPRO_URL is set (HTTP fan-out, not
# the Playwright pool). Kill with PROVIDER_CINEPRO=0. Optional:
# - PROVIDER_CINEPRO=1 → force on even without a URL (tests)
# - CINEPRO_EVAL_UNTIL=<unix_ms or ISO-8601> → 48h window without a URL
# CINEPRO_EVAL_UNTIL=
#
# Lordflix-class multi-provider API (co-located cinepro-core on Docker network embedin_default).
# Leave unset to disable. When set, scraper races CinePro first (14+ providers + stream proxy).
# CINEPRO_URL=http://cinepro-core:3000
#
# Optional LAN EmbedIn shell for watch-page "Embed" mode chips
# NEXT_PUBLIC_EMBEDIN_URL=http://192.168.1.107:4444
#
# Scraper log noise: debug | info | warn | error (default info)
# SCRAPER_LOG_LEVEL=info
#
# Shared warm Playwright pool. Default 1; accepted range is 1..4. Each browser
# owns multiple Chromium processes, so raise only after measuring host load.
# BROWSER_POOL_SIZE=1

# Optional: force Next.js bind host (set by docker-compose)
# HOSTNAME=0.0.0.0

# Legacy whole-file HEVC/MKV transcoder. Keep disabled in production: a cold
# stream can exceed safe shared-host CPU/RAM limits. Native browser-compatible
# debrid files remain available without it.
TRANSCODER_ENABLED=0

# Playback rollout kill switches. Track policy and fast 4K are ON when unset;
# set either public flag to 0 and rebuild for an immediate legacy rollback.
# NEXT_PUBLIC_PLAYBACK_TRACK_POLICY=0
# NEXT_PUBLIC_PLAYBACK_FAST_4K=0
# NEXT_PUBLIC_PLAYBACK_4K_PREWARM=0
# NEXT_PUBLIC_PLAYBACK_RANDOM_ACCESS_REMUX=0
# Observation-only coordinator comparison; it logs decisions but cannot alter playback.
# PLAYBACK_COORDINATOR_SHADOW=1

# Container external DNS. Defaults match hussyserver's LAN gateway plus an
# independent public fallback; override if the host moves networks.
# CINEHOME_DNS_PRIMARY=192.168.1.1
# CINEHOME_DNS_FALLBACK=1.1.1.1

# --- PREMIUM debrid tier (owner's own Real-Debrid account + Torrentio) ---
# Unset by default — the tier fully no-ops (zero debrid sources, embed roster
# unaffected) until REAL_DEBRID_API_TOKEN is set. Get the token from
# https://real-debrid.com/apitoken (personal API token, not the account
# password). Never share/log this value.
# REAL_DEBRID_API_TOKEN=your-real-debrid-api-token
# Torrentio instance (public default below; override only if self-hosting).
# TORRENTIO_BASE=https://torrentio.strem.fun

# --- TorBox (sibling debrid tier, FREE plan) ---
# Unset by default — fully dormant (zero TorBox sources) until set. Get the
# key from https://torbox.app -> Settings -> API. TorBox's free plan is quite
# restrictive (verified at https://support.torbox.app/en/articles/9836418):
# 1 torrent add per 24h, 1 active download at a time, 10 adds per month,
# 10GB max torrent size, no seeding, no private torrents. Cached (already-on-
# TorBox) titles are the only realistic use case here. Never share/log this
# value.
# TORBOX_API_KEY=your-torbox-api-key

# --- Cloudflare Worker HLS edge proxy (OFF by default — opt-in only) ---
# Many embed CDNs (Vixsrc / Luna, etc.) return HTTP 403 from Cloudflare IPs.
# Home /api/hls (residential) works; enabling Worker without verifying Upstream
# 200s will break ALL playback. Require explicit WORKER_PROXY_ENABLED=1.
# Deploy: cd workers/hls-proxy && npx wrangler login && npx wrangler deploy
#         npx wrangler secret put PROXY_SECRET   # same value as WORKER_PROXY_SECRET
# WORKER_PROXY_ENABLED=0
# WORKER_PROXY_BASE=https://cinehome-hls-proxy.<your-subdomain>.workers.dev
# WORKER_PROXY_SECRET=generate-with-openssl-rand-base64-32
# NEXT_PUBLIC_WORKER_PROXY_HOST=cinehome-hls-proxy.<your-subdomain>.workers.dev

# Required when NextAuth sits behind a reverse proxy or is reached on a
# non-localhost origin (Tailscale IP, LAN IP). Without it the callback host is
# rejected and sign-in fails with no useful error. Set in the live .env but
# undocumented here until now.
AUTH_TRUST_HOST=true
